# Host directories for new installations. Existing .env files keep their current layout.
COMPOSE_FILE=compose.yaml:compose.host.yaml
NRM_DATA_DIR=./data
STRFRY_DB_DIR=./strfry-db
# Set true when attaching an existing relay database; missing data.mdb stops startup.
REQUIRE_EXISTING_DB=false

# Comma-separated operator npubs (or 64-character hex public keys).
# Required to sign in. Never put an nsec/private key here.
ADMIN_NPUBS=
PUBLIC_ORIGIN=http://localhost:3000
RELAY_URL=ws://localhost:7777
RELAY_NAME=LNbits NRM
# Public base description; NRM automatically appends the current relay policy summary.
RELAY_DESCRIPTION=LNbits Nostr Relay Manager
# Optional public relay identity (npub or hex); defaults to the first admin key.
# This metadata key does not grant management access.
RELAY_PUBKEY=
# Public contact address, for example mailto:operator@example.com.
RELAY_CONTACT=
UI_BIND=127.0.0.1
UI_PORT=3000
RELAY_BIND=0.0.0.0
RELAY_PORT=7777
# Set false to lock AI moderation off for this deployment, including the API.
AI_MODERATION_ENABLED=true
BUILD_JOBS=2
