{
  "name": "lnbits-nrm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "start": "node server/main.js",
    "test": "node --test --test-isolation=none test/*.test.js",
    "test:integration": "node test/integration.mjs",
    "test:integration:ai-disabled": "node test/integration-ai-disabled.mjs",
    "test:integration:host-storage": "node test/integration-host-storage.mjs",
    "test:integration:reliability": "node test/integration-reliability.mjs",
    "test:integration:relay-info": "node test/integration-relay-info.mjs",
    "test:i18n:browser": "npm run build && node test/i18n-browser.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^10.1.7",
    "fastify": "^5.6.2",
    "ipaddr.js": "^2.2.0",
    "nostr-tools": "^2.17.0",
    "undici": "^7.16.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.2",
    "svelte": "^5.45.6",
    "svelte-check": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  }
}
